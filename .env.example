# Anthropic API key — never commit a real key
ANTHROPIC_API_KEY=

# Model for live mode (Haiku-class default)
ONCO_MODEL=claude-haiku-4-5

# Daily spend cap in USD (enforced in code)
ONCO_DAILY_SPEND_CAP_USD=1.00

# Eval / agent mode: stub (default, $0) or live
ONCO_MODE=stub

# Path to SQLite corpus DB (defaults to data/corpus.db)
ONCO_DB_PATH=data/corpus.db

# Corpus version expected by the agent
ONCO_CORPUS_VERSION=1.0.0
